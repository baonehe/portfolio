---
// Old per-section URLs: each redirects to its section on the main page.
import Moved from '../../components/Moved.astro';
import { sectionOrder } from '../../i18n/content';

export const getStaticPaths = () => sectionOrder.map((section) => ({ params: { section } }));

const { section } = Astro.params as { section: (typeof sectionOrder)[number] };
---

<Moved lang="vi" id={section} />
