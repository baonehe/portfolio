---
// The whole portfolio on one page: the hero with the scene, then every
// section in reading order, under a fixed menu.
import Base from '../layouts/Base.astro';
import About from './About.astro';
import Contact from './Contact.astro';
import Education from './Education.astro';
import Experience from './Experience.astro';
import Focus from './Focus.astro';
import Hero from './Hero.astro';
import SiteNav from './SiteNav.astro';
import Work from './Work.astro';
import { copy, sectionOrder, type Lang } from '../i18n/content';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = copy[lang];
const bodies = { about: About, experience: Experience, projects: Work, skills: Focus, education: Education, contact: Contact };
---

<Base lang={lang}>
  <SiteNav lang={lang} />
  <main id="main">
    <Hero lang={lang} />
    {
      sectionOrder.map((id) => {
        const Body = bodies[id];
        return (
          <section class="section" id={id} data-section-id aria-labelledby={`${id}-heading`}>
            <header class="section__head wrap">
              <h2 id={`${id}-heading`} class="display section__title" tabindex="-1">
                {t.sections[id].title}
              </h2>
              <p class="section__blurb">{t.sections[id].blurb}</p>
            </header>
            <Body lang={lang} />
          </section>
        );
      })
    }
  </main>
</Base>

<style>
  .section {
    border-top: 1px solid var(--line);
  }

  .section__head {
    display: grid;
    gap: var(--s-3);
    padding-block: var(--s-7) var(--s-6);
  }

  .section__title {
    font-size: clamp(2.75rem, 6vw, 5.5rem);
  }

  .section__blurb {
    color: var(--muted);
    font-size: clamp(1.125rem, 0.6vw + 1rem, 1.375rem);
    max-width: 40ch;
  }

  @media (max-width: 720px) {
    .section__head {
      padding-block: var(--s-6) var(--s-5);
    }
  }
</style>

<script>
  import { initSections } from '../scene/navigator';

  initSections();
</script>
