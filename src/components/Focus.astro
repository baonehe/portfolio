---
import { copy, type Lang } from '../i18n/content';
import { ph } from '../lib/ph';
import { icons } from '../sprites';
import PixelArt from './PixelArt.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = copy[lang].focus;
---

<div class="focus">
  <div class="wrap focus__grid">
    <p class="focus__intro" set:html={ph(t.intro)} />

      <ul class="areas">
        {
          t.areas.map((a) => (
            <li class="area">
              <PixelArt sprite={icons[a.icon]} class="area__icon" />
              <div class="area__main">
                <h3 class="area__title">{a.title}</h3>
                <p class="area__body" set:html={ph(a.body)} />
              </div>
              <div class="area__side">
                <p class="area__evidence">
                  <span class="label">{t.evidenceLabel}</span>
                  <span set:html={ph(a.evidence)} />
                </p>
                <p class="pixel area__tools" set:html={a.tools.map(ph).join(' · ')} />
              </div>
            </li>
          ))
        }
      </ul>
  </div>
</div>

<style>
  .focus {
    padding-bottom: var(--s-9);
  }

  .focus__grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--s-5);
  }

  .focus__intro {
    grid-column: 1 / span 4;
    color: var(--muted);
    max-width: 34ch;
  }

  .areas {
    grid-column: 6 / span 7;
    border-top: 1px solid var(--ink);
  }

  .area {
    display: grid;
    grid-template-columns: 56px minmax(0, 1fr) minmax(0, 15rem);
    gap: var(--s-5);
    padding-block: var(--s-6);
    border-bottom: 1px solid var(--line);
    transition: background-color 200ms ease-out;
  }

  .area :global(.area__icon) {
    width: 40px;
    color: var(--accent);
    margin-top: 6px;
    transition: transform 200ms steps(2);
  }

  .area:hover :global(.area__icon) {
    transform: translateY(-4px);
  }

  .area__main {
    display: grid;
    gap: var(--s-2);
  }

  .area__title {
    font-family: var(--font-display);
    font-weight: 700;
    font-stretch: 85%;
    font-size: clamp(1.5rem, 2vw, 1.875rem);
    line-height: 1.1;
    letter-spacing: -0.01em;
  }

  .area__body {
    max-width: 44ch;
  }

  .area__side {
    display: grid;
    gap: var(--s-3);
    align-content: start;
    padding-top: var(--s-2);
  }

  .area__evidence {
    display: grid;
    gap: var(--s-1);
    font-weight: 500;
  }

  .area__evidence .label {
    color: var(--muted);
  }

  .area__tools {
    color: var(--muted);
  }

  @media (max-width: 1100px) {
    .area {
      grid-template-columns: 48px minmax(0, 1fr);
    }
    .area__side {
      grid-column: 2;
      padding-top: 0;
    }
  }

  @media (max-width: 960px) {
    .focus__intro {
      grid-column: 1 / -1;
      margin-bottom: var(--s-7);
    }
    .areas {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 480px) {
    .area {
      grid-template-columns: 1fr;
      gap: var(--s-3);
    }
    .area__side {
      grid-column: 1;
    }
  }
</style>
