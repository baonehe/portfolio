---
// The fixed menu: name (back to the top), the sections in page order and the
// language switch. Wide screens show it as one row; narrow ones fold the
// sections and languages behind a "Contents" button. Without JavaScript the
// narrow menu stays a scrollable row instead.
import { copy, href, sectionOrder, site, type Lang, type SectionId } from '../i18n/content';
import { ph } from '../lib/ph';
import { arrowDown } from '../sprites';
import LangSwitch from './LangSwitch.astro';
import PixelArt from './PixelArt.astro';

interface Props {
  lang: Lang;
  /** On a page of its own (not the home page): the section it belongs to. */
  current?: SectionId;
  /** This page's URL in each language, for the language switch. */
  pages?: Record<Lang, string>;
}

const { lang, current, pages } = Astro.props;
const t = copy[lang];
---

<header class="nav" data-nav-root>
  <a class="nav__name" href={href(lang)}>
    <span set:html={ph(site.name)} />
  </a>

  <button class="nav__toggle" type="button" aria-expanded="false" aria-controls="nav-menu">
    {t.ui.contents}
    <PixelArt sprite={arrowDown} class="nav__toggle-icon" />
  </button>

  <div class="nav__menu" id="nav-menu">
    <nav aria-label={t.ui.sectionsLabel}>
      <ul class="nav__links">
        {
          sectionOrder.map((id) => (
            <li>
              <a href={href(lang, id)} data-nav={id} aria-current={id === current ? 'page' : undefined}>
                {t.sections[id].title}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <LangSwitch lang={lang} pages={pages} />
  </div>
</header>

<style>
  .nav {
    position: fixed;
    inset: 0 0 auto;
    z-index: 20;
    height: var(--nav-h);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-5);
    padding: 0 var(--gutter);
    background: var(--bg);
    border-bottom: 1px solid var(--line);
  }

  .nav__name {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    min-width: 0;
    font-family: var(--font-display);
    font-weight: 700;
    font-stretch: 85%;
    font-size: 1.25rem;
    text-decoration: none;
    white-space: nowrap;
  }

  .nav__name:hover {
    color: var(--link);
  }

  .nav__links {
    display: flex;
    gap: var(--s-1);
  }

  .nav__links a {
    display: grid;
    place-items: center;
    min-height: 44px;
    padding: 0 var(--s-3);
    color: var(--muted);
    font-size: 0.875rem;
    font-weight: 600;
    white-space: nowrap;
    text-decoration: none;
  }

  .nav__links a:hover {
    color: var(--ink);
  }

  /* The section being read: inverted, so it doesn't rely on color alone. */
  .nav__links a[aria-current] {
    background: var(--ink);
    color: var(--bg);
  }

  .nav__toggle {
    display: none;
    align-items: center;
    gap: var(--s-3);
    min-height: 44px;
    padding: 0 var(--s-4);
    border: 1px solid var(--control);
    background: var(--bg);
    color: var(--ink);
    font: inherit;
    font-size: 0.9375rem;
    font-weight: 600;
    cursor: pointer;
  }

  .nav__toggle:hover {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--on-accent);
  }

  .nav__toggle :global(.nav__toggle-icon) {
    width: 14px;
  }

  .nav__toggle[aria-expanded='true'] :global(.nav__toggle-icon) {
    rotate: 180deg;
  }

  @media (min-width: 1024px) {
    .nav__menu {
      display: contents;
    }
  }

  @media (max-width: 1023px) {
    /* Without JavaScript: the sections as one scrollable row under the bar. */
    .nav__menu {
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      display: flex;
      align-items: center;
      gap: var(--s-4);
      padding: var(--s-2) var(--gutter);
      background: var(--bg);
      border-bottom: 1px solid var(--line);
    }

    .nav__menu nav {
      min-width: 0;
      overflow-x: auto;
      scrollbar-width: none;
    }

    /* With JavaScript: a panel behind the Contents button. */
    :global(.js) .nav__toggle {
      display: inline-flex;
    }

    :global(.js) .nav__menu {
      display: none;
      flex-direction: column;
      align-items: stretch;
      gap: var(--s-4);
      padding: var(--s-2) var(--gutter) var(--s-5);
      max-height: calc(100svh - var(--nav-h));
      overflow-y: auto;
    }

    :global(.js) .nav[data-open] .nav__menu {
      display: flex;
    }

    :global(.js) .nav__menu nav {
      overflow: visible;
    }

    :global(.js) .nav__links {
      flex-direction: column;
      gap: 0;
    }

    :global(.js) .nav__links li + li {
      border-top: 1px solid var(--line);
    }

    :global(.js) .nav__links a {
      justify-items: start;
      min-height: 48px;
      padding: 0 var(--s-3);
      font-size: 1rem;
      color: var(--ink);
    }

    :global(.js) .nav__menu :global(.lang) {
      align-self: flex-start;
    }
  }
</style>

<script>
  const nav = document.querySelector<HTMLElement>('[data-nav-root]')!;
  const toggle = nav.querySelector<HTMLButtonElement>('.nav__toggle')!;

  const setOpen = (open: boolean) => {
    nav.toggleAttribute('data-open', open);
    toggle.setAttribute('aria-expanded', String(open));
  };

  toggle.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
  // Picking a section (or a language) closes the panel.
  nav.querySelector('.nav__menu')!.addEventListener('click', (event) => {
    if ((event.target as Element).closest('a')) setOpen(false);
  });
  nav.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape' || !nav.hasAttribute('data-open')) return;
    setOpen(false);
    toggle.focus();
  });
  document.addEventListener('click', (event) => {
    if (nav.hasAttribute('data-open') && !nav.contains(event.target as Node)) setOpen(false);
  });
  matchMedia('(min-width: 1024px)').addEventListener('change', () => setOpen(false));
</script>
