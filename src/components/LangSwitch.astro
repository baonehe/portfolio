---
// EN / VI. Links carry the section being read (navigator.ts keeps the hash
// up to date), so switching language stays on the same section.
import { copy, paths, type Lang } from '../i18n/content';

interface Props {
  lang: Lang;
  /** This page's URL in each language (defaults to the home page). */
  pages?: Record<Lang, string>;
}

const { lang, pages = paths } = Astro.props;
---

<nav class="lang" aria-label={copy[lang].ui.langLabel}>
  {
    (Object.keys(pages) as Lang[]).map((l) => (
      <a
        class="pixel"
        href={pages[l]}
        hreflang={l}
        lang={l}
        aria-current={l === lang ? 'page' : undefined}
        data-lang-base={pages[l]}
      >
        {l.toUpperCase()}
      </a>
    ))
  }
</nav>

<style>
  .lang {
    display: flex;
    border: 1px solid var(--control);
    background: var(--bg);
  }

  .lang a {
    display: grid;
    place-items: center;
    min-width: 44px;
    min-height: 44px;
    text-decoration: none;
  }

  .lang a[aria-current='page'] {
    background: var(--ink);
    color: var(--bg);
  }

  .lang a:not([aria-current]):hover {
    background: var(--accent);
    color: var(--on-accent);
  }
</style>
