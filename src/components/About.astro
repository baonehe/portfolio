---
import { copy, type Lang } from '../i18n/content';
import { ph } from '../lib/ph';
import { duck, mug } from '../sprites';
import PixelArt from './PixelArt.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = copy[lang].about;
---

<div class="about">
  <div class="wrap about__grid">
      <p class="about__lead display" set:html={ph(t.lead)} />

      <div class="about__body">
        {t.body.map((p) => <p set:html={ph(p)} />)}
      </div>

      <div class="about__aside">
        <dl class="facts">
          {
            t.facts.map((f) => (
              <div>
                <dt class="label">{f.label}</dt>
                <dd set:html={ph(f.value)} />
              </div>
            ))
          }
        </dl>
        <div class="about__desk">
          <PixelArt sprite={mug} class="about__mug" />
          <PixelArt sprite={duck} class="about__duck" />
        </div>
      </div>
  </div>
</div>

<style>
  .about {
    padding-bottom: var(--s-8);
  }

  .about__grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--s-5);
    row-gap: var(--s-7);
  }

  .about__lead {
    grid-column: 1 / span 10;
    font-size: clamp(2rem, 4.2vw, 3.75rem);
    font-stretch: 85%;
    font-weight: 700;
    line-height: 1.02;
  }

  .about__body {
    grid-column: 1 / span 6;
    display: grid;
    gap: var(--s-4);
    max-width: 60ch;
  }

  .about__aside {
    grid-column: 9 / span 4;
    display: grid;
    gap: var(--s-6);
    align-content: start;
  }

  .facts {
    display: grid;
    grid-template-columns: 1fr 1fr;
    border-top: 1px solid var(--ink);
  }

  .facts > div {
    display: grid;
    gap: var(--s-1);
    padding: var(--s-4) var(--s-3) var(--s-4) 0;
    border-bottom: 1px solid var(--line);
  }

  .facts dt {
    color: var(--muted);
  }

  .facts dd {
    margin: 0;
    font-weight: 500;
  }

  /* The mug and the duck share one table line: both grids are 14 wide at 6×. */
  .about__desk {
    display: flex;
    align-items: flex-end;
  }

  .about__desk :global(.about__mug),
  .about__desk :global(.about__duck) {
    flex: none;
    width: 84px;
  }

  @media (max-width: 960px) {
    .about__lead,
    .about__body {
      grid-column: 1 / -1;
    }
    .about__aside {
      grid-column: 1 / span 8;
    }
  }

  @media (max-width: 560px) {
    .about__grid {
      row-gap: var(--s-6);
    }
    .about__aside {
      grid-column: 1 / -1;
    }
  }
</style>
